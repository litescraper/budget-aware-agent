# LLM access (REQUIRED) — set the API key for the provider(s) you use.
# Model names use LiteLLM's provider prefixes, e.g.:
#   anthropic/claude-sonnet-4-5  -> ANTHROPIC_API_KEY
#   gemini/gemini-2.5-flash      -> GEMINI_API_KEY (Google AI Studio)
#   openai/gpt-5                 -> OPENAI_API_KEY
#   vertex_ai/gemini-2.5-pro     -> no key; run `gcloud auth application-default login`
ANTHROPIC_API_KEY=your_anthropic_api_key
#GEMINI_API_KEY=your_gemini_api_key
#OPENAI_API_KEY=your_openai_api_key

# LLM judge for evaluation and answer scoring (optional override)
#JUDGE_MODEL=gemini/gemini-2.5-flash

# Web search (REQUIRED — pick ONE backend via SEARCH_BACKEND or --search_backend)
# Option A: serper.dev (Google results; free tier available)
SEARCH_BACKEND=serper
SERPER_API_KEY=your_serper_api_key
# Option B (paper setting): Google Custom Search JSON API (default backend when
# SEARCH_BACKEND is unset)
#SEARCH_BACKEND=cse
#CSE_ID=your_google_cse_search_engine_id
#CSE_API_KEYS=your_google_cse_api_key  # One or more keys, comma-separated; extra keys rotate on rate limits

# Tool configuration
TOOL_CALL_TAG=tool_code  # Tag the prompts instruct the model to use (default: tool_code)

# Browse tool
BROWSE_CACHE_DB=outputs/cache/browse_cache.sqlite
JINA_API_KEY=your_jina_api_key  # Optional, for Jina AI content extraction
BROWSE_CACHE_TTL_SEC=0  # Cache expiration in seconds (0 = no expiration)
